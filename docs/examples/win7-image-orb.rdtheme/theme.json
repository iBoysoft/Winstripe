{
  "$schema": "winstripe-theme/1",
  "id": "win7-image-orb",
  "name": {
    "en": "Winstripe 7 Image Orb",
    "zh-Hans": "Winstripe 7 图片圆球"
  },
  "version": 1,
  "family": "modern",
  "extends": "win7",
  "metrics": {
    "barThickness": 40,
    "verticalBarWidth": 160,
    "verticalBarWidthWhenCombined": 62,
    "buttonGap": 0,
    "taskButton": {
      "minWidth": 60,
      "maxWidth": 160,
      "iconSize": 32,
      "iconSizeLabelled": 16,
      "iconSizePlain": 16
    },
    "quickLaunch": {
      "buttonSize": 24,
      "pitch": 24,
      "iconSize": 16
    },
  "cornerRadius":3
  },
  "bar": {
    "material": {
      "type": "aeroGlass",
      "variant": "win7",
      "tint": {
        "color": "#2D4B64",
        "alpha": 0.78
      },
      "params": {
        "sheenTop": 0.1,
        "sheenBottom": 0,
        "edgeOuterBlack": 0.9,
        "edgeInnerWhite": 0.25,
        "verticalFullSheen": false,
        "verticalSheenTop": 0.1,
        "verticalSheenBottom": 0,
        "sheenFraction": 0.5,
        "edgeWidth": 1,
        "edgeOuterColor": {
          "white": 0,
          "alpha": 0.9
        },
        "edgeInnerColor": {
          "white": 1,
          "alpha": 0.25
        },
        "separatorDark": {
          "white": 0,
          "alpha": 0.7
        },
        "separatorLight": {
          "white": 1,
          "alpha": 0.25
        },
        "separatorVerticalInset": 4,
        "separatorHorizontalInset": 5,
        "separatorWidth": 1
      }
    },
    "edge": {
      "all": []
    }
  },
  "buttons": {
    "task": {
      "normal": {
        "fill": {
          "type": "aeroButton",
          "hotTrack": "iconAverage",
          "params": {
            "inset": 1.5,
            "radius": 3,
            "normalAlpha": 0.12,
            "hoverAlpha": 0.2,
            "pressedAlpha": 0.05,
            "lowerAlpha": 0.08,
            "highlightAlpha": 0.12,
            "activeAlpha": 0.32,
            "activeHighlightAlpha": 0.24,
            "borderAlpha": 0.3,
            "activeBorderAlpha": 0.6,
            "innerBorderAlpha": 0.45
          }
        }
      },
      "title": {
        "color": "system:white",
        "layout": "fixed",
        "x": 28,
        "trailingInset": 4,
        "smoothing": "setting"
      },
      "fillRule": {
        "activeTriggers": false,
        "normalWhen": "runningTask"
      },
      "iconOffsetY": 0,
      "iconOffsetYLabelled": 0,
      "iconLeadingLabelled": 6,
      "icon": {
        "iconOnly": 16,
        "clampInset": 4,
        "symbolSource": "sfPalette",
        "symbolColor": "system:white"
      },
      "runningIndicator": {
        "type": "none"
      },
    "normalFill":[{"white":1,"alpha":0.18},{"white":1,"alpha":0.06}],
    "activeFill":[{"white":1,"alpha":0.4},{"white":1,"alpha":0.16}],
    "borderColor":{"white":1,"alpha":0.35}
    },
    "desktopStrip": {
      "normalAlpha": 0.2,
      "hoverAlpha": 0.4,
      "lowerAlpha": 0.06,
      "edgeAlpha": 0.5
    },
    "badge": {
      "shape": "pill",
      "size": [
        16,
        13
      ],
      "radius": 6,
      "offset": [
        -18,
        2
      ],
      "fill": "system:systemRed",
      "font": {
        "ref": "badge"
      },
      "textColor": "system:white",
      "showsText": true
    }
  },
  "fonts": {
    "badge": {
      "weight": "regular"
    },
    "smoothing": "userSetting"
  },
  "layout": {
    "engine": "aero",
    "pins": "superbar",
    "labelMode": "byGrouping",
    "groupingDefault": "alwaysCombine",
    "grouping": {
      "fitMinWidth": 60,
      "reservedSpace": 60,
      "reservedSpaceVertical": 60
    },
    "vertical": {
      "taskHeight": 40,
      "taskPitch": 44,
      "forceIconOnly": false,
      "startY": 4,
      "inset": 0,
      "startWidth": "fixed",
      "startSize": 40,
      "startHeight": 40,
      "afterStartGap": 4,
      "buttonHeight": 40,
      "taskWidth": "fixed",
      "taskSize": 40,
      "labelledWidth": 160,
      "labelledPitch": 164,
      "quickLaunchWrap": false,
      "quickLaunchPitch": 44,
      "pinnedQuickLaunchCentered": false,
      "quickLaunchHideReserve": 0,
      "afterQuickLaunchGap": 0,
      "hideTaskGap": 4,
      "taskHideHeight": 40,
      "traySizing": "fixed",
      "trayHeight": 90,
      "trayMinY": 48,
      "trayInsetBottom": 0,
      "trayReserve": 0
    },
    "linear": {
      "taskWidth": "measured",
      "rounding": "none",
      "subtractGaps": false,
      "quickPlacement": "group",
      "trayWidth": "remaining",
      "buttonCross": "center",
      "startCross": "center",
      "startX": 4,
      "startY": 0,
      "startHeight": 40,
      "startHeightInset": 0,
      "startAdvanceGap": 4,
      "taskY": 0,
      "taskHeight": 40,
      "taskHeightInset": 0,
      "iconWidth": 40,
      "pinnedIconWidth": true,
      "labelGap": 4,
      "quickSeparator": false,
      "taskSeparator": false,
      "trayY": 0,
      "trayHeight": 0,
      "trayHeightInset": 0,
      "trayTrailing": 0,
      "trayGap": 0,
      "hideGap": 0,
      "availableTrailing": 12,
      "edgeMin": 4,
      "groupTrayGap": 8,
      "leading": 4,
      "quickTrailing": 0
    },
    "startInGroup": false,
    "classicOneButtonPerAppWidth": false,
    "alignment": "left",
    "alignmentOptions": [
      "left"
    ],
    "overflow": "shrinkThenHide",
    "fixedItems": [],
    "aero": {
      "taskHeight": 40,
      "verticalTaskHeight": 40,
      "orbSize": 42,
      "orbX": 6,
      "orbY": -1,
      "orbAnchor": "fixed",
      "orbVerticalY": 2,
      "orbWidthInset": 4,
      "contentLeading": 54,
      "trayVerticalReserve": 8,
      "afterOrbGap": 6,
      "quickSize": 24,
      "quickPitch": 24,
      "quickHideGap": 4,
      "quickSeparatorGap": 6,
      "quickSeparatorGapVertical": 5,
      "taskWidthInset": 4,
      "iconWidth": 60,
      "limitPinnedWidth": true,
      "combinedWidth": 60,
      "labelledWidth": 160,
      "minWidth": 28,
      "fitGap": 3,
      "taskGap": 0,
      "taskGapVertical": 0
    }
  },
  "tray": {
    "layout": "aero",
    "smoothing": "setting",
    "items": [
      "chevron",
      "inputLanguage",
      "clock",
      "actionCenter",
      "showDesktop"
    ],
    "hover": null,
    "chevron": {
      "style": "aeroTriangle",
      "alwaysShown": true,
      "advance": 22,
      "drawAdvance": 22,
      "paintWhenHidden": true,
      "symbolCollapsed": "",
      "symbolExpanded": "",
      "color": "system:white",
      "frame": {
        "x": 3,
        "y": 0,
        "width": 22,
        "height": 0,
        "heightMode": "bounds"
      },
      "frameVertical": {
        "y": 0,
        "width": 0,
        "height": 20,
        "widthMode": "bounds"
      }
    },
    "inputLanguage": {
      "width": 28,
      "advance": 28,
      "drawAdvance": 28,
      "textColor": "system:white",
      "rect": {
        "width": 28
      },
      "rectVertical": {
        "x": 0,
        "y": 0,
        "yPlacement": "flow",
        "widthMode": "bounds",
        "clampWidth": false
      },
    "fill":"#1E69DE"
    },
    "actionCenter": {
      "advance": 24,
      "drawAdvance": 24,
      "symbol": "flag.fill",
      "toggles": true,
      "color": "system:white",
      "frame": {
        "x": 25,
        "width": 24,
        "heightMode": "bounds"
      },
      "frameVertical": {
        "y": 20,
        "height": 24,
        "widthMode": "bounds"
      },
      "width": 24
    },
    "clock": {
      "measure": "clockText",
      "measureFont": {
        "family": "Tahoma",
        "fallback": "system"
      },
      "measureDateFont": {
        "family": "Tahoma",
        "fallback": "system"
      },
      "measureFallback": "88:88 PM",
      "minWidth": 76,
      "extraWidth": 14,
      "color": "system:white",
      "lines": [
        {
          "format": {
            "en": "h:mm a",
            "zh-Hans": "H:mm"
          },
          "offsetY": 0,
          "height": 17,
          "font": {
            "family": "system",
            "size": 12
          },
          "fontVertical": {
            "family": "system",
            "size": 10
          },
          "halves": false,
          "fullHeight": false
        },
        {
          "format": "shortDate",
          "offsetY": 17,
          "height": 17,
          "font": {
            "family": "system",
            "size": 12
          },
          "fontVertical": {
            "family": "system",
            "size": 9
          },
          "halves": false,
          "fullHeight": false
        }
      ],
      "rect": {
        "height": 34,
        "clampWidth": true
      },
      "rectVertical": {
        "y": 0,
        "height": 34,
        "insetX": 2,
        "yPlacement": "flow",
        "widthMode": "bounds"
      }
    },
    "showDesktop": {
      "style": "aeroStrip",
      "width": 15,
      "reserve": 15,
      "drawReserve": 15,
      "frame": {
        "x": 15,
        "width": 15
      },
      "frameVertical": {
        "x": 0,
        "y": 15,
        "width": 0,
        "height": 15,
        "xPlacement": "fixed",
        "yPlacement": "trailing",
        "widthMode": "bounds",
        "heightMode": "fixed"
      }
    },
    "vertical": {
      "trigger": "verticalLayout",
      "threshold": 0,
      "base": 0,
      "trailing": 6,
      "contentBase": 44,
      "rows": [
        {
          "name": "clock",
          "height": 40,
          "always": false,
          "preferred": true
        },
        {
          "name": "inputLanguage",
          "height": 22,
          "always": false,
          "preferred": true
        },
        {
          "name": "leading",
          "height": 44,
          "always": true,
          "preferred": true
        },
        {
          "name": "showDesktop",
          "height": 15,
          "always": false,
          "preferred": true
        }
      ]
    }
  },
  "startButton": {
    "previewWallpaper": "win7",
    "drawer": "image",
    "drawerParams": {
      "file": "assets/orb.png",
      "width": 42,
      "height": 42,
      "fit": "contain"
    },
    "overflow": {
      "outer": 0,
      "enabled": false,
      "panelMargin": 0,
      "panelWidth": 42,
      "panelHeight": 42,
      "panelInset": 0,
      "previewExtraHeight": 0,
      "menuPadding": 0
    },
  "fill":["#6DB3F2","#1E69DE","#0E3F8C"],
  "textColor":"system:white"
  },
      "startMenu": {
    "default": "win7",
  "colors":{"face":"#F4F7FC","text":"system:black","highlight":"#3399FF"},
  "banner":{"fill":["#2B4C73","#10233A"],"text":"system:white","suffix":"7"}
  },
  "previews": {
    "style": "aeroGlass"
  }
}
